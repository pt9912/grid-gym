.agents/
.codex/
.claude/

# Python-Build-/Test-Artefakte.
# Projekt-Policy: alle Builds und Tests laufen ueber das
# Multi-Stage-Dockerfile, angesprochen via Makefile-Targets
# (`make lint`, `make typecheck`, `make gates`, ...). Lokale
# Python-Umgebungen sind ausdruecklich unerwuenscht — `uv sync`
# darf nur innerhalb der Dockerfile-Stages laufen. Diese Eintraege
# schuetzen das Repo, falls trotzdem mal eine lokale Toolchain
# Artefakte hinterlaesst.
.venv/
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
*.egg
build/
dist/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
.coverage.*
coverage/
coverage.xml
htmlcov/
.hypothesis/

# Release-Workflow-Artifacts (M6-Welle-2; ADR 0042):
# `make sbom` produziert hier `sbom-v<X>.cdx.json`; der Release-
# Workflow ergaenzt JUnit-XML, Coverage-HTML-Tarball, OpenAPI-JSON
# und Demo-Abnahme-MD. Alle Files sind Build-Output, kein Source.
artifacts/

# Generated-Trivyignore (M6-Welle-4a; ADR 0044):
# `make render-trivyignore` produziert hier `.trivyignore` aus
# `deploy/security/vulnignore.yaml` (Audit-Source-of-Truth). Die
# Output-Datei ist Maschinen-Output; vulnignore.yaml ist die
# kanonische Quelle und versioniert.
deploy/security/.trivyignore

# IDE / Editor lokal
.idea/
.vscode/
*.swp
*.swo
